<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="ElectroPiAutomationSuite" parallel="methods" thread-count="4" verbose="1">

    <listeners>
        <listener class-name="listeners.TestListener"/>
    </listeners>

    <test name="smoke">
        <groups>
            <run>
                <include name="smoke"/>
            </run>
        </groups>
        <classes>
            <class name="tests.InventoryTests"/>
        </classes>
    </test>

    <test name="regression">
        <groups>
            <run>
                <include name="regression"/>
            </run>
        </groups>
        <classes>
            <class name="tests.InventoryTests"/>
        </classes>
    </test>

</suite>
