          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 201 Created\", function () {\r\n    pm.response.to.have.status(201);\r\n});\r\n\r\nconst response = pm.response.json();\r\n\r\npm.test(\"SKU is returned in the response\", function () {\r\n    pm.expect(response).to.have.property(\"sku\");\r\n});\r\n\r\nconst expectedSku = pm.variables.get(\"sku\");\r\n\r\npm.test(\"Returned SKU matches requested SKU\", function () {\r\n    pm.expect(response.sku).to.eql(expectedSku);\r\n});"
            ]
          }
        }
      ],
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{authToken}}",
              "type": "string"
